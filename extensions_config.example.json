{
  "mcpInterceptors": [
    "deerflow.mcp.connector_interceptor:build_interceptor"
  ],
  "mcpServers": {
    "connectors": {
      "enabled": false,
      "type": "http",
      "url": "http://localhost:5173/mcp",
      "headers": {
        "Authorization": "Bearer $ANYCONNECT_RUNTIME_TOKEN"
      },
      "description": "Connect to 1000+ SaaS tools — Gmail, GitHub, Slack, Notion, WeCom, and more. Your agents can send emails, manage repos, search docs, and automate workflows across all your apps."
    },
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "tool_call_timeout": 60,
      "description": "GitHub MCP server for repository operations"
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "description": "PostgreSQL database access",
      "routing": {
        "mode": "prefer",
        "priority": 50,
        "keywords": [
          "database",
          "SQL",
          "table",
          "订单",
          "用户"
        ]
      },
      "tools": {
        "query": {
          "routing": {
            "mode": "prefer",
            "priority": 100,
            "keywords": [
              "查库",
              "订单表",
              "指标"
            ]
          }
        }
      }
    }
  },
  "skills": {}
}
