{
  "mcpInterceptors": [
    "my_package.mcp.auth:build_auth_interceptor"
  ],
  "mcpServers": {
    "github": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "description": "GitHub MCP server for repository operations"
    },
    "postgres": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "description": "PostgreSQL database access"
    },
    "kurrentdb": {
      "enabled": false,
      "type": "stdio",
      "command": "uv",
      "args": ["--directory", "/absolute/path/to/kurrent-io/mcp-server", "run", "server.py"],
      "env": {
        "KURRENTDB_CONNECTION_STRING": "$KURRENTDB_CONNECTION_STRING"
      },
      "description": "KurrentDB stream exploration — lets the agent read its own memory event streams (see backend/docs/KURRENTDB_MEMORY.md)"
    }
  },
  "skills": {}
}
