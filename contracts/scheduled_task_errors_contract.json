  "agent_only_codes": [
    "timezone_required",
    "authentication_required",
    "permission_denied",
    "scheduler_tools_disabled",
    "authority_expired",
    "conversation_not_found",
    "interactive_run_required",
    "unsupported_action",
    "unsupported_fields",
    "task_id_required",
    "note_not_verbatim",
    "note_limit_reached",
    "trial_requires_direct_request",
    "no_stop_authority",
    "occurrence_not_active"
  ]
