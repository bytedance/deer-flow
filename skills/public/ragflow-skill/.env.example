# ragflow-retrieval skill — RAGFlow connection
# Copy to .env and fill in (scripts auto-load on startup):
#   cp .env.example .env

# Required: RAGFlow server base URL (no /api/v1 suffix).
# Example: RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_BASE_URL=

# Required: API key from RAGFlow UI → Settings → API Keys.
RAGFLOW_API_KEY=

# Optional: HTTP timeout in seconds (default 60).
# RAGFLOW_TIMEOUT=60
