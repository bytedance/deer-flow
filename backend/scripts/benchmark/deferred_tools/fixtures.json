        "slack_search_messages",
        "slack_send_message",
        "jupyter_create_notebook",
        "jupyter_run_cell",
        "calendar_list_events",
        "calendar_create_event",
        "archive_search_records"
      ],
      "expected_tools": [
        "github_search_repositories"
      ],
      "required_fields": {
        "github_search_repositories": [
          "language"
        ]
