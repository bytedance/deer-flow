{
  "version": 1,
  "kind": "synthetic",
  "tools": [
    {
      "name": "github_search_repositories",
      "description": "Search GitHub repositories by topic and programming language.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Repository search text"
          },
          "language": {
            "type": "string",
            "description": "Programming language filter"
          }
        },
        "required": [
          "query",
          "language"
        ],
        "additionalProperties": false
      },
      "routing_keywords": [
        "github",
        "repository"
      ]
    },
    {
      "name": "github_get_issue",
      "description": "Read one GitHub issue and its discussion.",
      "parameters": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Owner/repository"
          },
          "issue_number": {
            "type": "integer",
            "description": "Issue identifier"
          }
        },
        "required": [
          "repository",
          "issue_number"
        ],
        "additionalProperties": false
      },
      "routing_keywords": [
        "github",
        "issue"
      ]
    },
    {
      "name": "github_create_issue",
      "description": "Create an issue in a GitHub repository.",
      "parameters": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Owner/repository"
          },
          "title": {
            "type": "string",
            "description": "Issue summary"
          },
          "body": {
            "type": "string",
            "description": "Issue details"
          }
        },
        "required": [
          "repository",
          "title",
          "body"
        ],
        "additionalProperties": false
      },
      "routing_keywords": [
        "github",
        "issue"
      ]
    },
    {
      "name": "gitlab_search_projects",
      "description": "Search GitLab projects and repository metadata.",
      "parameters": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "description": "Project query"
          },
          "visibility": {
            "type": "string",
            "description": "Project visibility filter"
          }
        },
        "required": [
          "search",
          "visibility"
        ],
        "additionalProperties": false
      },
      "routing_keywords": [
        "gitlab",
        "repository"
      ]
    },
    {
      "name": "slack_search_messages",
      "description": "Search Slack channel messages by text and date.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Message search text"
          },
          "channel": {
            "type": "string",
            "description": "Slack channel"
          },
          "before": {
            "type": "string",
            "description": "Last date"
          }
        },
        "required": [
          "query",
          "channel",
          "before"
        ],
        "additionalProperties": false
      },
      "routing_keywords": [
        "slack",
        "message"
      ]
    },
    {
      "name": "slack_send_message",
      "description": "Send a new message to a Slack channel.",
      "parameters": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "description": "Destination channel"
          },
          "text": {
            "type": "string",
            "description": "Message body"
          }
        },
        "required": [
          "channel",
          "text"
        ],
        "additionalProperties": false
      },
      "routing_keywords": [
        "slack",
        "message"
      ]
    },
    {
      "name": "jupyter_create_notebook",
      "description": "Create a Jupyter notebook with a chosen kernel.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Notebook path"
          },
          "kernel": {
            "type": "string",
            "description": "Kernel name"
          }
        },
        "required": [
          "path",
          "kernel"
        ],
        "additionalProperties": false
      },
      "routing_keywords": [
        "jupyter",
        "notebook"
      ]
    },
    {
      "name": "jupyter_run_cell",
      "description": "Execute one existing Jupyter notebook cell.",
      "parameters": {
        "type": "object",
        "properties": {
          "notebook": {
            "type": "string",
            "description": "Notebook path"
          },
          "cell_id": {
            "type": "string",
            "description": "Cell identifier"
          }
        },
        "required": [
          "notebook",
          "cell_id"
        ],
        "additionalProperties": false
      },
      "routing_keywords": [
        "jupyter",
        "cell"
      ]
    },
    {
      "name": "calendar_list_events",
      "description": "List calendar events within a date range.",
      "parameters": {
        "type": "object",
        "properties": {
          "start_date": {
            "type": "string",
            "description": "First date"
          },
          "end_date": {
            "type": "string",
            "description": "Last date"
          },
          "calendar_id": {
            "type": "string",
            "description": "Calendar identifier"
          }
        },
        "required": [
          "start_date",
          "end_date",
          "calendar_id"
        ],
        "additionalProperties": false
      },
      "routing_keywords": [
        "calendar",
        "event"
      ]
    },
    {
      "name": "calendar_create_event",
      "description": "Create a calendar event and invite attendees.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Event title"
          },
          "start_time": {
            "type": "string",
            "description": "Start timestamp"
          },
          "attendees": {
            "type": "array",
            "description": "Attendee addresses",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "start_time",
          "attendees"
        ],
        "additionalProperties": false
      },
      "routing_keywords": [
        "calendar",
        "event"
      ]
    },
    {
      "name": "archive_search_records",
      "description": "检索归档记录，按作者和主题筛选。",
      "parameters": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string",
            "description": "作者"
          },
          "topic": {
            "type": "string",
            "description": "主题"
          }
        },
        "required": [
          "author",
          "topic"
        ],
        "additionalProperties": false
      },
      "routing_keywords": [
        "归档",
        "作者"
      ]
    },
    {
      "name": "admin_delete_repository",
      "description": "Permanently delete a private GitHub repository. Administrator only.",
      "parameters": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Repository identifier"
          },
          "confirmation": {
            "type": "boolean",
            "description": "Confirm deletion"
          }
        },
        "required": [
          "repository",
          "confirmation"
        ],
        "additionalProperties": false
      },
      "routing_keywords": [
        "github",
        "repository",
        "delete"
      ]
    }
  ],
