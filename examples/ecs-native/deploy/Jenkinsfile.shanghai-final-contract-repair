  post {
    always {
      timeout(time: 5, unit: 'MINUTES') {
        sh '''set +x
set -eu
python3 -c "import hashlib;from pathlib import Path;assert hashlib.sha256(Path('scripts/ecs_native_final_contract_repair.py').read_bytes()).hexdigest()=='7e7b0014f86a066c4febaa4c9ad394b07b0c7cc5b8650f725a6826945386ca71'"
