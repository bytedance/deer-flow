pipeline {
  agent { node { label 'shanghai-builder'; customWorkspace '/data/jenkins-agent/deerflow/native-task6b-56636cebddc6' } }
  options { disableConcurrentBuilds(); skipDefaultCheckout(true); timeout(time: 75, unit: 'MINUTES'); timestamps() }
  parameters {
    choice(name: 'PHASE', choices: ['final-contract'], description: 'One reviewed source gate; no build or role changes')
    string(name: 'FINAL_ARCHIVE_NAME', defaultValue: '', description: 'Reviewed immutable public archive basename')
    string(name: 'FINAL_ARCHIVE_SHA256', defaultValue: '', description: 'Reviewed immutable archive hash')
    string(name: 'FINAL_SOURCE_SHA256', defaultValue: '', description: 'Reviewed source entry hashes')
    string(name: 'FINAL_MANIFEST_SHA256', defaultValue: '', description: 'Reviewed embedded manifest hash')
  }
  stages {
    stage('Final source gates in isolated accepted image') {
      options { timeout(time: 65, unit: 'MINUTES') }
      steps {
        withEnv(["FINAL_ARCHIVE_NAME=${params.FINAL_ARCHIVE_NAME}", "FINAL_ARCHIVE_SHA256=${params.FINAL_ARCHIVE_SHA256}", "FINAL_SOURCE_SHA256=${params.FINAL_SOURCE_SHA256}", "FINAL_MANIFEST_SHA256=${params.FINAL_MANIFEST_SHA256}"]) {
          sh '''set +x
set -eu
python3 -c "import hashlib;from pathlib import Path;assert hashlib.sha256(Path('scripts/ecs_native_final_contract.py').read_bytes()).hexdigest()=='fbf95bbfcd00cc9973954f27b9ca6185fdd58649dbd05356915c0263bafbe02a';assert hashlib.sha256(Path('scripts/ecs_native_final_contract_inner.py').read_bytes()).hexdigest()=='422ac621194bd2ed1243c04b90066bc741956385f783f19fb34a655b169424d8'"
python3 scripts/ecs_native_final_contract.py "$FINAL_ARCHIVE_NAME" "$FINAL_ARCHIVE_SHA256" "$FINAL_SOURCE_SHA256" "$FINAL_MANIFEST_SHA256"
'''
        }
      }
    }
  }
  post {
    always {
      timeout(time: 5, unit: 'MINUTES') {
        sh '''set +x
set -eu
python3 -c "import hashlib;from pathlib import Path;assert hashlib.sha256(Path('scripts/ecs_native_final_contract.py').read_bytes()).hexdigest()=='fbf95bbfcd00cc9973954f27b9ca6185fdd58649dbd05356915c0263bafbe02a'"
python3 scripts/ecs_native_final_contract.py --cleanup
'''
      }
      archiveArtifacts artifacts: 'native-final-contract-*/receipt.json,native-final-contract-*/public-gates.log', allowEmptyArchive: true, fingerprint: true
    }
  }
}
