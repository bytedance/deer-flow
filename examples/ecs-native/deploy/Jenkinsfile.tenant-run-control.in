pipeline {
 agent { node { label 'shanghai-builder'; customWorkspace '/data/jenkins-agent/deerflow/tenant-execution-m4-sql' } }
 options { disableConcurrentBuilds(); skipDefaultCheckout(true); timeout(time: 8, unit: 'MINUTES'); timestamps() }
 stages { stage('Native Run stop @@PHASE@@') { steps { sh '''set +x
set -eu
[ "${JOB_NAME:-}" = "deerflow-tenant-execution-m4-sql" ]
[ "$PWD" = "/data/jenkins-agent/deerflow/tenant-execution-m4-sql" ]
printf '%s  %s\n' '@@SOURCE_SHA256@@' '@@PHASE@@-source.tar.gz' | sha256sum --check
fixture="deerflow-tenant-execution-m4-sql-${BUILD_NUMBER}"
pg="${fixture}-db"
shared="$PWD/run-control-${BUILD_NUMBER}"
mkdir -p "$shared"
chmod 700 "$shared"
image=$(docker image inspect --format '{{.Id}}' deerflow-native:final-ci-tools-52ce)
[ "$image" = 'sha256:4f269f6b0e50f9579e099e91a23df868ff1b1a49c03cc9b138beac02dafb3f01' ]
cleanup() {
 for target in "$fixture" "$pg"; do
  owned=$(docker inspect -f '{{ index .Config.Labels "org.deerflow.tenant.owned" }}' "$target" 2>/dev/null || true)
  if [ "$owned" = "$fixture" ]; then
   docker inspect --format '{{range .Mounts}}{{if eq .Type "volume"}}{{.Name}}{{println}}{{end}}{{end}}' "$target" > "$shared/${target}-volumes.txt"
   docker rm -fv "$target" >/dev/null
  fi
 done
 owned=$(docker network inspect -f '{{ index .Labels "org.deerflow.tenant.owned" }}' "$fixture" 2>/dev/null || true)
 if [ "$owned" = "$fixture" ]; then docker network rm "$fixture" >/dev/null; fi
}
trap cleanup EXIT HUP INT TERM
docker network create --internal --label "org.deerflow.tenant.owned=$fixture" "$fixture" >/dev/null
docker run -d --pull=never --name "$pg" --network "$fixture" --label "org.deerflow.tenant.owned=$fixture" --cpus .5 --memory 512m --memory-swap 512m -e POSTGRES_PASSWORD=tenant-test-only -e POSTGRES_DB=tenant_test sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea >/dev/null
attempt=0
until docker exec "$pg" pg_isready -U postgres -d tenant_test >/dev/null 2>&1; do
 attempt=$((attempt+1)); [ "$attempt" -lt 30 ]; sleep 1
done
docker run --rm --pull=never --name "$fixture" --label "org.deerflow.tenant.owned=$fixture" --label org.deerflow.tenant.phase=m4-run-control --network "$fixture" -e "TEST_EXECUTOR_POSTGRES_URL=postgresql+psycopg://postgres:tenant-test-only@$pg:5432/tenant_test" --cpus 1 --memory 2g --memory-swap 2g -v "$PWD/@@PHASE@@-source.tar.gz:/run/source.tar.gz:ro" --entrypoint /bin/sh "$image" -c 'mkdir /tmp/source && tar xzf /run/source.tar.gz -C /tmp/source && cd /tmp/source/backend && export PYTHONPATH=/tmp/source/backend:/tmp/source/backend/packages/harness:/tmp/source/backend/packages/extension-api:/tmp/source/backend/packages/ecs-executor && export DEER_FLOW_HOME=/tmp/tenant-home && /app/backend/.venv/bin/python -m pytest @@TEST_PATHS@@ -q --tb=short --no-showlocals && /app/backend/.venv/bin/python -m ruff check --no-cache packages/harness/deerflow/persistence/workspaces/run_control.py packages/harness/deerflow/persistence/workspaces/execution_control.py packages/harness/deerflow/persistence/run/sql.py packages/harness/deerflow/runtime/runs/store/base.py packages/harness/deerflow/runtime/runs/manager.py packages/harness/deerflow/runtime/runs/worker.py tests/test_workspace_revocation.py tests/test_workspace_run_lifetime.py tests/test_workspace_run_checkpoints.py packages/harness/deerflow/runtime/checkpointer/scoped_run.py tests/test_workspace_worker_effects.py packages/harness/deerflow/runtime/events/store/db.py packages/harness/deerflow/runtime/journal.py packages/harness/deerflow/runtime/stream_bridge/scoped_worker.py packages/harness/deerflow/persistence/thread_meta/sql.py packages/harness/deerflow/runtime/invocation.py packages/harness/deerflow/agents/middlewares/workspace_execution_middleware.py packages/harness/deerflow/agents/middlewares/tool_error_handling_middleware.py packages/harness/deerflow/models/factory.py tests/test_workspace_invocation_gate.py packages/harness/deerflow/extensions/ordering.py tests/test_tool_error_handling_middleware.py packages/harness/deerflow/extensions/model_invocation.py packages/harness/deerflow/agents/middlewares/title_middleware.py packages/harness/deerflow/agents/middlewares/summarization_middleware.py tests/test_workspace_model_service_lifetime.py packages/harness/deerflow/runtime/goal.py packages/harness/deerflow/sandbox/tools.py tests/test_workspace_sandbox_dispatch.py packages/harness/deerflow/agents/middlewares/read_before_write_middleware.py tests/test_workspace_native_dispatch.py app/gateway/native_admission.py packages/ecs-executor/ecs_executor/agent_dispatch.py packages/ecs-executor/ecs_executor/job_store.py tests/test_ecs_executor_operations.py && /app/backend/.venv/bin/python -m ruff format --check packages/harness/deerflow/persistence/workspaces/run_control.py packages/harness/deerflow/persistence/workspaces/execution_control.py packages/harness/deerflow/persistence/run/sql.py packages/harness/deerflow/runtime/runs/store/base.py packages/harness/deerflow/runtime/runs/manager.py packages/harness/deerflow/runtime/runs/worker.py tests/test_workspace_revocation.py tests/test_workspace_run_lifetime.py tests/test_workspace_run_checkpoints.py packages/harness/deerflow/runtime/checkpointer/scoped_run.py tests/test_workspace_worker_effects.py packages/harness/deerflow/runtime/events/store/db.py packages/harness/deerflow/runtime/journal.py packages/harness/deerflow/runtime/stream_bridge/scoped_worker.py packages/harness/deerflow/persistence/thread_meta/sql.py packages/harness/deerflow/runtime/invocation.py packages/harness/deerflow/agents/middlewares/workspace_execution_middleware.py packages/harness/deerflow/agents/middlewares/tool_error_handling_middleware.py packages/harness/deerflow/models/factory.py tests/test_workspace_invocation_gate.py packages/harness/deerflow/extensions/ordering.py tests/test_tool_error_handling_middleware.py packages/harness/deerflow/extensions/model_invocation.py packages/harness/deerflow/agents/middlewares/title_middleware.py packages/harness/deerflow/agents/middlewares/summarization_middleware.py tests/test_workspace_model_service_lifetime.py packages/harness/deerflow/runtime/goal.py packages/harness/deerflow/sandbox/tools.py tests/test_workspace_sandbox_dispatch.py packages/harness/deerflow/agents/middlewares/read_before_write_middleware.py tests/test_workspace_native_dispatch.py app/gateway/native_admission.py packages/ecs-executor/ecs_executor/agent_dispatch.py packages/ecs-executor/ecs_executor/job_store.py tests/test_ecs_executor_operations.py' > @@PHASE@@.log 2>&1
''' } } }
 post { always { archiveArtifacts artifacts: '@@PHASE@@.log', allowEmptyArchive: false, fingerprint: true } }
}