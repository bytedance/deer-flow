# Separate mode-0600 worker.env. The worker never receives the executor DB URL.
DATABASE_URL=postgresql://gateway:REPLACE@PRIVATE_CONTROLLER_IP:5432/deerflow
ECS_NATIVE_METADATA_DATABASE_URL=postgresql+psycopg://gateway:REPLACE@PRIVATE_CONTROLLER_IP:5432/deerflow
REDIS_URL=redis://:REPLACE@PRIVATE_CONTROLLER_IP:6379/0
AUTH_JWT_SECRET=REPLACE_SHARED
DEER_FLOW_INTERNAL_AUTH_TOKEN=REPLACE_SHARED
ECS_NODE_TOKEN=REPLACE_SHARED
ECS_EXECUTOR_SCOPE_SECRET=REPLACE_SHARED
ECS_EXECUTOR_SCOPE_SERVER=ecs
ECS_EXECUTOR_SCOPE_SUBMIT_TOOL=submit
ECS_EXECUTOR_SCOPE_STATUS_TOOL=status
ECS_EXECUTOR_SCOPE_CANCEL_TOOL=cancel
ECS_EXECUTOR_SCOPE_AUDIENCE=executor
ECS_OWNER_HEADER=Bearer REPLACE
ECS_DISCOVERY_HEADER=Bearer REPLACE
ECS_MODEL_NAME=REPLACE
ECS_MODEL_KEY=REPLACE
ECS_MODEL_URL=https://REPLACE/v1
# SSL_CERT_FILE=/run/operator/ca.crt
