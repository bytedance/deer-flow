# Copy into a protected mode-0600 controller.env. Values below are placeholders.
# Supply secrets from the operator secret manager; do not source this file.
POSTGRES_PASSWORD=REPLACE
REDIS_PASSWORD=REPLACE
DATABASE_URL=postgresql://postgres:REPLACE@postgres:5432/deerflow
ECS_EXECUTOR_DATABASE_URL=postgresql+psycopg://postgres:REPLACE@postgres:5432/deerflow_execution
ECS_NATIVE_METADATA_DATABASE_URL=postgresql+psycopg://postgres:REPLACE@postgres:5432/deerflow
REDIS_URL=redis://:REPLACE@redis:6379/0
AUTH_JWT_SECRET=REPLACE_SHARED
DEER_FLOW_INTERNAL_AUTH_TOKEN=REPLACE_SHARED
ECS_NODE_TOKEN=REPLACE_SHARED
ECS_EXECUTOR_SCOPE_SECRET=REPLACE_SHARED
ECS_EXECUTOR_SCOPE_SERVER=ecs
ECS_EXECUTOR_SCOPE_SUBMIT_TOOL=submit
ECS_EXECUTOR_SCOPE_STATUS_TOOL=status
ECS_EXECUTOR_SCOPE_CANCEL_TOOL=cancel
ECS_EXECUTOR_SCOPE_AUDIENCE=executor
ECS_OWNER_TOKEN=REPLACE
ECS_DISCOVERY_TOKEN=REPLACE
ECS_OWNER_HEADER=Bearer REPLACE
ECS_DISCOVERY_HEADER=Bearer REPLACE
ECS_MODEL_NAME=REPLACE
ECS_MODEL_KEY=REPLACE
ECS_MODEL_URL=https://REPLACE/v1
ECS_FRONTEND_IMAGE=REPLACE@sha256:REPLACE
ECS_PRIVATE_BIND_HOST=127.0.0.1
ECS_PUBLIC_BIND_HOST=127.0.0.1
ECS_CONTROL_SUBNET=172.29.61.0/24
ECS_PROXY_IP=172.29.61.10
# For an owned private CA, mount its certificate with the private directory.
# SSL_CERT_FILE=/run/operator/ca.crt
