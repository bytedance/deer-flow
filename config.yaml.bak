config_version: 11
log_level: info

token_usage:
  enabled: true

models:
  - name: minimax-m2.5
    display_name: MiniMax M2.5 (Dashscope)
    use: langchain_openai:ChatOpenAI
    model: MiniMax/MiniMax-M2.5
    api_key: sk-cbc2f7fcb3a54bc38f8782f0138cffcb
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    request_timeout: 600.0
    max_retries: 2
    max_tokens: 131072
    temperature: 1.0
    supports_vision: true
    supports_thinking: true
    when_thinking_enabled:
      extra_body: 
        thinking:
          type: adaptive
    when_thinking_disabled:
      extra_body:
        thinking:
          type: disabled

  - name: minimax-m3
    display_name: MiniMax M3 (Dashscope)
    use: langchain_openai:ChatOpenAI
    model: MiniMax/MiniMax-M3
    api_key: sk-cbc2f7fcb3a54bc38f8782f0138cffcb
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    request_timeout: 600.0
    max_retries: 2
    max_tokens: 131072
    temperature: 1.0
    supports_vision: true
    supports_thinking: true
    when_thinking_enabled:
      extra_body:
        thinking:
          type: adaptive
    when_thinking_disabled:
      extra_body:
        thinking:
          type: disabled

  - name: deepseek-v4-pro
    display_name: DeepSeek V4 Pro (Dashscope)
    use: langchain_openai:ChatOpenAI
    model: deepseek-v4-pro
    api_key: sk-cbc2f7fcb3a54bc38f8782f0138cffcb
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    request_timeout: 600.0
    max_retries: 2
    max_tokens: 393216
    temperature: 0.7
    supports_vision: false
    supports_thinking: true
    when_thinking_enabled:
      extra_body:
        thinking:
          type: enabled
    when_thinking_disabled:
      extra_body:
        thinking:
          type: disabled

