    request_timeout: 600.0
    max_retries: 2
    max_tokens: 393216
    temperature: 0.7
    supports_vision: false
    supports_thinking: true
    when_thinking_enabled:
      extra_body:
        thinking:
          type: enabled
    when_thinking_disabled:
      extra_body:
        thinking:
          type: disabled

  - name: glm-5.1
    display_name: GLM 5.1 (Dashscope)
