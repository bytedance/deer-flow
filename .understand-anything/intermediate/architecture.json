{
  "layers": [
    {
      "name": "gateway",
      "description": "API网关层，基于FastAPI构建，负责HTTP路由分发、认证鉴权(JWT/API Key)、请求限流、CSRF防护及依赖注入。对外暴露REST API并通过Nginx反向代理统一入口。",
      "modules": [
        "backend/app/gateway",
        "backend/app/gateway/routers",
        "backend/app/gateway/auth",
        "backend/app/gateway/middleware"
      ]
    },
    {
      "name": "channels",
      "description": "IM渠道集成层，桥接飞书、钉钉、Slack、Telegram、Discord、企业微信等外部消息平台，通过消息总线和ChannelManager将外部消息转发至LangGraph智能体运行时。",
      "modules": [
        "backend/app/channels"
      ]
    },
    {
      "name": "agent-runtime",
      "description": "智能体运行时层，基于LangGraph构建Lead Agent编排引擎，包含18层中间件链、子智能体委派、记忆系统、线程状态管理和流式桥接。是系统的核心AI推理引擎。",
      "modules": [
        "backend/packages/harness/deerflow/agents",
        "backend/packages/harness/deerflow/subagents",
        "backend/packages/harness/deerflow/runtime",
        "backend/packages/harness/deerflow/client"
      ]
    },
    {
      "name": "tools",
      "description": "工具与扩展层，提供智能体可调用的全部工具能力，包括内置工具(present_files/ask_clarification/view_image/http_connector)、MCP协议工具、社区搜索工具(Tavily/Jina/Firecrawl)以及报告模板工具集。",
      "modules": [
        "backend/packages/harness/deerflow/tools",
        "backend/packages/harness/deerflow/mcp",
        "backend/packages/harness/deerflow/community",
        "backend/packages/harness/deerflow/skills"
      ]
    },
    {
      "name": "sandbox",
      "description": "沙箱执行层，提供隔离的代码执行环境，支持本地文件系统和Docker容器两种模式，实现虚拟路径映射和文件操作安全审计。",
      "modules": [
        "backend/packages/harness/deerflow/sandbox",
        "backend/packages/harness/deerflow/guardrails",
        "backend/packages/harness/deerflow/content_safety"
      ]
    },
    {
      "name": "domain",
      "description": "领域业务层，封装工业领域核心业务逻辑，包括知识库RAG、闭环工单、洞察分析、报告模板DSL引擎和工业系统适配器(CRM/ERP/INS/SMS/XSY)。",
      "modules": [
        "backend/packages/harness/deerflow/rag",
        "backend/packages/harness/deerflow/knowledge_base",
        "backend/packages/harness/deerflow/closed_loop",
        "backend/packages/harness/deerflow/insights",
        "backend/packages/harness/deerflow/report_templates",
        "backend/packages/harness/deerflow/integrations",
        "backend/packages/harness/deerflow/feedback",
        "backend/packages/harness/deerflow/cost",
        "backend/packages/harness/deerflow/audio"
      ]
    },
    {
      "name": "foundation",
      "description": "基础设施层，提供全局共享的底层能力：LLM模型工厂、配置系统、反射加载器、数据持久化(SQLAlchemy)、对象存储和遥测监控。",
      "modules": [
        "backend/packages/harness/deerflow/config",
